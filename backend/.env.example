# ─────────────────────────────────────────────────────────────
# Droguería EKA — Variables de entorno (plantilla)
# Copia este archivo como .env y completa los valores reales.
# El archivo .env NO debe subirse al repositorio.
# ─────────────────────────────────────────────────────────────

# Entorno de ejecución: development | production | test
NODE_ENV=development
PORT=3000

# ── Base de datos (SQL Server / Azure SQL) ───────────────────
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=DrogueriaEKA_DB
DB_USER=sa
DB_PASSWORD=            # OBLIGATORIO — sin valor por defecto
DB_PORT=1433

# ── Seguridad JWT ─────────────────────────────────────────────
# OBLIGATORIO en producción. Usa una cadena larga y aleatoria.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ── Semillas / administración inicial ─────────────────────────
ADMIN_EMAIL=admin@drogueria-eka.com
ADMIN_PASSWORD=          # OBLIGATORIO para ejecutar seed_admin.js
SEED_USER_PASSWORD=      # Opcional; si se omite, se genera aleatoria

# ── Frontends permitidos por CORS ─────────────────────────────
FRONTEND_URL=http://localhost:5173
INSTITUCIONAL_URL=http://localhost:5174

# ── Azure Language / CLU (opcional; si falta, usa NLP local) ──
AZURE_LANGUAGE_ENDPOINT=
AZURE_LANGUAGE_KEY=
AZURE_LANGUAGE_PROJECT=
AZURE_LANGUAGE_DEPLOYMENT=

# ── Azure Notification Hubs (push a la app; si falta, push en modo MOCK) ──
# Connection string con permiso "Full" del hub y el nombre del hub.
AZURE_NH_CONNECTION_STRING=
AZURE_NH_NAME=
