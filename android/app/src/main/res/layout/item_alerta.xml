<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Indicador de severidad -->
        <View
            android:id="@+id/viewSeverity"
            android:layout_width="6dp"
            android:layout_height="48dp"
            android:background="@color/colorStockWarning" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/tvNombreProducto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre del producto"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvCodigoProducto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COD-000"
                android:textSize="12sp"
                android:textColor="@color/colorTextMuted"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Stock info -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/tvStockActual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/colorStockCritical" />

            <TextView
                android:id="@+id/tvStockMinimo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mín: 0"
                android:textSize="11sp"
                android:textColor="@color/colorTextMuted" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
